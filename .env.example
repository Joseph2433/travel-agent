# ===== 旅图 TravelAgent 配置 =====
# 复制本文件为 .env 后填写。全部可留空——缺省时自动降级（估算/规则引擎）。
# 注意：.env 在进程启动时读取，修改后要重启 python run.py。

# 高德 Web 服务 API（restapi.amap.com 服务端 key，非 JS API key）
# 启用：IP定位 / 地理编码 / POI搜索 / 实时天气 / 驾车路径
AMAP_KEY=

# 大模型决策（OpenAI 兼容协议，Kimi/DeepSeek/OpenAI 通用）
# 启用：目的地复核首推 / 攻略情报取舍 / 方案推荐语
# 注意：BASE_URL 和 MODEL 必须和 key 所属的厂商一致，例如：
#   Moonshot → LLM_BASE_URL=https://api.moonshot.cn/v1  LLM_MODEL=kimi-k2-0905-preview
#   DeepSeek → LLM_BASE_URL=https://api.deepseek.com    LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2-0905-preview

# 多渠道（可选）：上面是内置渠道 default；LLM_CHANNELS 可追加渠道（JSON 数组），
# LLM_CHANNEL 选择生效渠道名（缺省 default，渠道没配 key 自动回退 default）
# 字段：name 必填；key/base_url/model 缺省继承 default；
#       format = chat（默认 /chat/completions）| responses（/responses 新协议）；
#       temperature 可选（responses 渠道默认不传，推理模型拒收非默认 temperature）
# 例：
# LLM_CHANNELS=[{"name":"xpeach","key":"sk-你的key","base_url":"https://xpeach.codes/v1","model":"gpt-5.2","format":"responses"}]
# LLM_CHANNEL=xpeach
LLM_CHANNEL=
LLM_CHANNELS=

# 博查 AI 搜索（可选）：open.bochaai.com 申请 key，有免费额度、国内直连
# 配置后攻略网页摘要走博查（中文质量好、索引覆盖小红书等社区内容），
# 不配则自动回退到 Bing/DuckDuckGo 网页抓取
BOCHA_API_KEY=

# 去哪儿门票 / uapis 热榜 / 12306：公开接口，无需任何配置即可用
# （真实景点票价、各平台热搜榜、真实车次）

# 小红书攻略源（可选），两种部署方式二选一：
# A. 本地 xiaohongshu-mcp（github.com/xpzouying/xiaohongshu-mcp release 二进制）
#    → 填 XHS_API_BASE=http://localhost:18060；服务设了 AUTH_TOKEN 则填 XHS_API_TOKEN
#    → 注意：内置无头浏览器的 leakless.exe 易被杀软误报，需把安装目录与
#      %TEMP%\leakless-* 加入信任区
# B. x-mcp 浏览器插件版（零部署，复用浏览器登录态，不碰杀软）
#    → Chrome 商店装「小红书MCP助手」插件 → aredink.com 注册拿 API Token
#    → 填 XHS_API_BASE=https://mcp.aredink.com/mcp + XHS_API_TOKEN=<token>
# C. 自建透传中继（本服务内嵌，不依赖 aredink 云端，插件可直连 Render 后端）
#    → XHS_RELAY_TOKEN=自设一个强随机串
#    → XHS_API_BASE=https://<本服务域名>/xhs/mcp + XHS_API_TOKEN=<同一串>
#    → 插件设置页：服务器地址 wss://<本服务域名>/xhs/ws，API Key 填同一串
#    → /api/status 里 xhs.relay_online=true 表示插件已连上中继
# 均为第三方逆向方案而非官方API，仅适合个人学习用途，账号有风控风险
XHS_API_BASE=
XHS_API_TOKEN=
XHS_RELAY_TOKEN=

# ===== 账号体系（可选） =====
# 不配 = 本地开发免登录（空用户表 → /api/* 全部放行）
# 配置后启用鉴权：无注册入口，仅管理员可开号
# 支持两种写法：
#   JSON 数组  AUTH_SEED=[{"user":"admin","pass":"你的密码","role":"admin"}]
#   简写       AUTH_SEED=admin:你的密码,bob:另一个密码   （缺省 role=admin）
# 本地也可命令行开号：python backend/auth.py add <用户名> <密码> [admin|user]
# 注意：云端（Render）文件系统是临时的——运行时在管理面板添加的账号
#       会在重启/重部署后丢失，长期账号请写进 AUTH_SEED
AUTH_SEED=
